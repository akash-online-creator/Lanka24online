rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    // Help posts and community notices
    match /help_posts/{postId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if true;

      // Realtime subcollection for chat messages
      match /chat_messages/{messageId} {
        allow read: if true;
        allow create: if true;
        allow update, delete: if true;
      }
    }

    // Community marketplace items
    match /marketplace_items/{itemId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // Registered user profiles
    match /users/{userId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // User reviews & ratings
    match /reviews/{reviewId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // Bookmarked/saved posts per user
    match /saved_posts/{saveId} {
      allow read, write: if true;
    }

    // Red Alerts (රතු එළිය) - Real-time disaster broadcasts & community emergency updates
    match /red_alerts/{alertId} {
      allow read: if true;
      allow create, update, delete: if true;

      // Subcollections if any
      match /{allSubcollections=**} {
        allow read, write: if true;
      }
    }

    // System Settings - Global siren and emergency alert configurations
    match /system_settings/{settingId} {
      allow read: if true;
      allow write: if true;
    }

    // Transparent Aid Ledger Collections
    match /aid_recipient_centers/{centerId} {
      allow read, write: if true;
    }

    match /aid_deliveries/{deliveryId} {
      allow read, write: if true;
    }

    match /aid_broadcasts/{broadcastId} {
      allow read, write: if true;
    }

    // Barter & Exchange Collections
    match /barter_items/{itemId} {
      allow read, write: if true;
    }

    match /barter_proposals/{proposalId} {
      allow read, write: if true;
    }

    // QR Code Payments & Transactions
    match /qr_transactions/{txId} {
      allow read, write: if true;
    }

    // Live Online Presence Heartbeat
    match /online_users/{sessionId} {
      allow read, write: if true;
    }

    // SOS Live GPS Tracking Sessions (හදිසි සජීවී ස්ථාන විකාශන)
    match /sos_live_sessions/{sessionId} {
      allow read, write: if true;
    }

    // Default fallback
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
