rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // 👤 REGISTERED USER PROFILES (/users/{userId})
    match /users/{userId} {
      allow read: if true;
      allow create: if request.resource.data.role != 'admin'
                    && request.resource.data.status != 'approved';
      allow update: if (resource.data.role == 'admin' || request.resource.data.role != 'admin')
                    && (!('nicNumber' in resource.data) || request.resource.data.nicNumber == resource.data.nicNumber)
                    && (!('userId' in resource.data) || request.resource.data.userId == resource.data.userId);
      allow delete: if false;
    }

    // 🚨 RED ALERTS (රතු එළිය ආපදා සයිරන්) (/red_alerts/{alertId})
    match /red_alerts/{alertId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if true;

      match /{allSubcollections=**} {
        allow read, write: if true;
      }
    }

    // 🤝 HELP POSTS & COMMUNITY NOTICES
    match /help_posts/{postId} {
      allow read, create, update, delete: if true;
      match /{subcollection=**} {
        allow read, create, update, delete: if true;
      }
    }

    match /posts/{postId} {
      allow read, create, update, delete: if true;
      match /{subcollection=**} {
        allow read, create, update, delete: if true;
      }
    }

    // 📋 ISSUES & SUPPORT TICKETS (/issues/{issueId})
    match /issues/{issueId} {
      allow read, create, update: if true;
      allow delete: if false;
    }

    // 🛒 MARKETPLACE & SHOPS
    match /marketplace/{itemId} {
      allow read, create, update, delete: if true;
    }
    match /marketplace_items/{itemId} {
      allow read, create, update, delete: if true;
    }
    match /market_shops/{shopId} {
      allow read, create, update, delete: if true;
    }

    // 🩸 BLOOD BANK & DISASTER RELIEF
    match /blood_requests/{reqId} {
      allow read, create, update, delete: if true;
    }
    match /disaster_relief/{reliefId} {
      allow read, create, update, delete: if true;
    }
    match /volunteer_donors/{donorId} {
      allow read, create, update, delete: if true;
    }

    // 🛠️ PROFESSIONAL SERVICES & ARTISANS
    match /professional_services/{serviceId} {
      allow read, create, update, delete: if true;
    }

    // 👥 GROUP WORK / ශ්‍රමදාන
    match /groups/{groupId} {
      allow read, create, update, delete: if true;
    }

    // 🏥 AID RECIPIENT CENTERS & DELIVERIES
    match /aid_centers/{centerId} {
      allow read, create, update: if true;
      allow delete: if false;
    }
    match /aid_recipient_centers/{centerId} {
      allow read, create, update: if true;
      allow delete: if false;
    }
    match /aid_deliveries/{deliveryId} {
      allow read, create, update: if true;
      allow delete: if false;
    }
    match /aid_broadcasts/{broadcastId} {
      allow read, create, update: if true;
      allow delete: if false;
    }

    // ⚙️ SYSTEM SETTINGS & METADATA
    match /system_metadata/{settingId} {
      allow read, write: if true;
    }
    match /system_settings/{settingId} {
      allow read, write: if true;
    }

    // 🔖 BOOKMARKS, REVIEWS, QR PAYMENTS & SOS SESSIONS
    match /saved_posts/{saveId} {
      allow read, write: if true;
    }
    match /reviews/{reviewId} {
      allow read, create, update: if true;
      allow delete: if false;
    }
    match /qr_transactions/{txId} {
      allow read, create, update: if true;
      allow delete: if false;
    }
    match /online_users/{sessionId} {
      allow read, write: if true;
    }
    match /sos_live_sessions/{sessionId} {
      allow read, write: if true;
    }

    // 🔒 DEFAULT FALLBACK
    match /{document=**} {
      allow read: if true;
      allow write: if false;
    }
  }
}
