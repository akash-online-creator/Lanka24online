rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ආරක්ෂක සහයක ශ්‍රිත (Helper Functions)
    function isSignedIn() {
      return request.auth != null;
    }

    function getUserData() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data
        : null;
    }

    function isAdmin() {
      return isSignedIn() && getUserData() != null && getUserData().role == 'admin';
    }

    // ==============================================================
    // 1. 👤 පරිශීලක ගිණුම් (/users/{userId})
    // ==============================================================
    match /users/{userId} {
      allow read: if true;
      // නව ගිණුම් ලියාපදිංචි කිරීම සහ යාවත්කාලීන කිරීම (Permission Denied වීම වළක්වා ඇත)
      allow create, update: if true;
      allow delete: if isAdmin() || true;
    }

    // ==============================================================
    // 2. 🤝 ප්‍රජා සටහන් සහ උපකාර දැන්වීම් (/posts, /help_posts)
    // ==============================================================
    match /posts/{postId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if true;

      match /{subcollection=**} {
        allow read: if true;
        allow write: if true;
      }
    }

    match /help_posts/{postId} {
      allow read: if true;
      allow create, update, delete: if true;

      match /{subcollection=**} {
        allow read: if true;
        allow write: if true;
      }
    }

    // ==============================================================
    // 3. 🚨 රතු එළිය - හදිසි ආපදා අනතුරු ඇඟවීම් (/red_alerts)
    // ==============================================================
    match /red_alerts/{alertId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if true;

      match /{allSubcollections=**} {
        allow read: if true;
        allow write: if true;
      }
    }

    // ==============================================================
    // 4. ⚙️ පද්ධති සැකසුම් සහ Metadata (/system_settings, /system_metadata)
    // ==============================================================
    match /system_settings/{settingId} {
      allow read: if true;
      allow write: if true;
    }

    match /system_metadata/{settingId} {
      allow read: if true;
      allow write: if true;
    }

    // ==============================================================
    // 5. 📋 තාක්ෂණික ගැටලු සහ සහාය ටිකට්පත් (/issues/{issueId})
    // ==============================================================
    match /issues/{issueId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if true;
    }
    // ==============================================================
    // 6. 🛒 ප්‍රජා වෙළඳපොළ සහ වෙළඳසැල් (Marketplace & Shops)
    // ==============================================================
    match /marketplace/{itemId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    match /marketplace_items/{itemId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    match /market_shops/{shopId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // ==============================================================
    // 7. 🩸 ලේ බැංකුව සහ ආපදා ආධාර (Blood Bank & Relief)
    // ==============================================================
    match /blood_requests/{reqId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    match /disaster_relief/{reliefId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    match /volunteer_donors/{donorId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // ==============================================================
    // 8. 🛠️ වෘත්තීය සේවා (Professional Services)
    // ==============================================================
    match /professional_services/{serviceId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // ==============================================================
    // 9. 👥 සමූහ වැඩ සහ ශ්‍රමදාන (Groups)
    // ==============================================================
    match /groups/{groupId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // ==============================================================
    // 10. 🏥 ආධාර මධ්‍යස්ථාන සහ ලෙජරය (Aid Centers & Deliveries)
    // ==============================================================
    match /aid_centers/{centerId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    match /aid_recipient_centers/{centerId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    match /aid_deliveries/{deliveryId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    match /aid_broadcasts/{broadcastId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // ==============================================================
    // 11. 🔖 සුරැකි දැන්වීම්, සමාලෝචන, මුරපද සහ SOS සැසි
    // ==============================================================
    match /saved_posts/{saveId} {
      allow read, write: if true;
    }

    match /reviews/{reviewId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    match /qr_transactions/{txId} {
      allow read, write: if true;
    }

    match /online_users/{sessionId} {
      allow read, write: if true;
    }

    match /sos_live_sessions/{sessionId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    match /password_reset_requests/{requestId} {
      allow read, write: if true;
    }

    match /pending_ai_queries/{queryId} {
      allow read, write: if true;
    }

    match /verified_ai_knowledge/{itemId} {
      allow read, write: if true;
    }

    // පෙරනිමි විවෘත කිරීම (අනෙකුත් ඕනෑම collection එකකට කියවීමට/ලිවීමට ඉඩ දීම)
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
